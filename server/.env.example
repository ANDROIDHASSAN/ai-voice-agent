# ─────────────────────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────────────────────
PORT=8080
# The PUBLIC https URL of THIS server, reachable by Vapi's cloud.
# Local dev: run `ngrok http 8080` and paste the https URL here.
# Production: your Render/Railway/Fly URL.
SERVER_PUBLIC_URL=https://your-ngrok-or-host.example.com

# Comma-separated origins allowed to call this API (your React app)
CLIENT_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────
#  DATABASE  (MongoDB Atlas free M0 tier — https://mongodb.com/atlas)
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/voiceagent?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────
#  VAPI  (free $10 credit — https://dashboard.vapi.ai)
# ─────────────────────────────────────────────────────────────
VAPI_PRIVATE_KEY=vapi_private_key_here
# Random string you invent. Vapi sends it back on every webhook so we can verify.
VAPI_WEBHOOK_SECRET=make-up-a-long-random-string

# ─────────────────────────────────────────────────────────────
#  GROQ  (free API key — https://console.groq.com/keys)
#  This key is stored INSIDE Vapi as the LLM provider key.
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here

# ─────────────────────────────────────────────────────────────
#  GOOGLE CALENDAR  (free — https://console.cloud.google.com)
#  Run `npm run google:auth` to obtain GOOGLE_REFRESH_TOKEN.
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
GOOGLE_REFRESH_TOKEN=
# The calendar consults land on (the founder's). "primary" = the authorised account's main calendar.
GOOGLE_CALENDAR_ID=primary
FOUNDER_EMAIL=founder@example.com

# ─────────────────────────────────────────────────────────────
#  AGENCY DETAILS  (these fill the [BRACKETS] in the system prompt)
# ─────────────────────────────────────────────────────────────
AGENT_NAME=Aanya
AGENCY_NAME=Your Agency Name
FOUNDER_NAME=Founder Name
CITY_HQ=Pune
YEARS=9
FLAGSHIP_PROOF=we produce the Mrs India pageant and several state editions
BRAND_PROOF=multi-city activations for names like Lakme across five states
CONSULT_LENGTH_MIN=30
TIMEZONE=Asia/Kolkata
# Business hours used when suggesting free slots (24h, local TIMEZONE)
BUSINESS_HOURS_START=10
BUSINESS_HOURS_END=19
